# Copy to .env.local and fill in. .env.local is gitignored.

# ---- OpenAI (document reading + embeddings) ---------------------------------
OPENAI_API_KEY=sk-...

# Vision model that reads the uploaded PDFs/images into JSON.
# gpt-5.5 = measured extraction/OCR leader (91.2% OCR, 87.6% extraction).
# Cheaper: gpt-5.6-terra (~half price, but bottom-quartile on data extraction)
# or gpt-5.4-mini (budget tier). gpt-5-mini is deprecated, dies 2026-12-11.
OPENAI_VISION_MODEL=gpt-5.4-mini
# text-embedding-3-large at dimensions=1536 (set in code): beats small@1536
# outright, same vector(1536) column. Changing this = re-embed everything.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Answering model when CHAT_PROVIDER=openai. gpt-5.6-luna at reasoning effort
# "none" (pinned in code): ~0.75s TTFT, fastest output in class.
OPENAI_CHAT_MODEL=gpt-5.6-luna

# ---- Answering model (voice pipeline) ---------------------------------------
# Which provider generates spoken answers: deepseek (default) | openai.
CHAT_PROVIDER=deepseek

# ---- DeepSeek (used when CHAT_PROVIDER=deepseek) -----------------------------
DEEPSEEK_API_KEY=sk-...
# deepseek-v4-flash = fast/cheap tier of the V4 line. Reasoning is a per-request
# MODE, which the code pins OFF (thinking:disabled) for voice latency — leaving
# it on streams a chain-of-thought first AND silently ignores temperature. The
# old deepseek-chat / deepseek-reasoner ids were retired 2026-07-24 (404 now).
# deepseek-v4-pro is the stronger, ~3x pricier tier. Prefix caching is automatic.
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# Bare base (no /v1); the /v1 path is an alias if you prefer it.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Read values back verbatim (only applies with thinking off). 0.0 = most
# deterministic; 0.3 keeps phrasing/script natural.
DEEPSEEK_TEMPERATURE=0.3

# ---- Deepgram (speech to text) ---------------------------------------------
# Region. The default api.deepgram.com is NORTH AMERICA and is the worst leg in
# this pipeline from India — measured TCP RTT from Delhi: default 249ms,
# api.eu.deepgram.com 194ms, api.au.deepgram.com 174ms (every other upstream is
# 6-44ms). The socket is persistent, so this RTT is paid on EVERY turn: audio up,
# EndOfTurn back. There is no India/Singapore region. Verify the model is served
# there first:  DEEPGRAM_HOST=api.au.deepgram.com node scripts/diag-deepgram.mjs
DEEPGRAM_HOST=api.deepgram.com
# Needs Member or higher permissions to mint short-lived browser tokens.
DEEPGRAM_API_KEY=
# Flux = conversational model with built-in end-of-turn detection, Nova-3 level
# accuracy. Use flux-general-en for English-only callers.
DEEPGRAM_MODEL=flux-general-multi
# Language biasing for the multilingual model (ignored by flux-general-en).
DEEPGRAM_LANGUAGE_HINTS=hi,en
# Confidence needed to end a turn (0.5-0.9, default 0.7). Raise if callers get
# cut off while reading out an account number; lower for snappier turn-taking.
DEEPGRAM_EOT_THRESHOLD=0.8
# Hard ceiling on silence before the turn closes anyway (500-60000 ms).
# Deepgram's guidance: 7000+ for callers with frequent mid-utterance pauses.
DEEPGRAM_EOT_TIMEOUT_MS=7000
# Fires EagerEndOfTurn early so the LLM starts while the caller trails off
# (audio still waits for the real EndOfTurn). Must be <= EOT_THRESHOLD.
DEEPGRAM_EAGER_EOT_THRESHOLD=0.5
# Domain terms to bias recognition toward (comma-separated, 500-token cap).
DEEPGRAM_KEYTERMS=Aadhaar,IFSC,PAN,KYC,passbook

# ---- Sarvam (text to speech) -----------------------------------------------
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
# priya = the only speaker both Tier 1 (0.13% critical-error rate) and on the
# docs' recommended-for-Hindi list. Alternatives: ishita, mani (male).
# Audition at dashboard.sarvam.ai before locking in.
SARVAM_SPEAKER=priya
# hi-IN drives number/abbreviation handling for code-mixed Hinglish.
SARVAM_LANGUAGE=hi-IN
# 24000 is bulbul:v3's native rate.
SARVAM_SAMPLE_RATE=24000
SARVAM_PACE=1.0
# Randomness (v3 only, 0.01-1.0, default 0.6). Each sentence is a separate
# request with no seed, so higher values make the voice shift between clips.
# 0.01-0.2 = "flat, highly consistent"; 0.3-0.5 = "controlled, professional".
SARVAM_TEMPERATURE=0.2

# ---- Supabase ---------------------------------------------------------------
# Project settings -> API. The service-role key is server-only; never expose it
# to the browser (nothing here is prefixed NEXT_PUBLIC_, which is deliberate).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Answering context strategy ---------------------------------------------
# hybrid (default) = per-turn RAG retrieval, small prompt, cache hit is PERSONA
#   only (~1.3k tok) because the retrieved block changes every turn.
# full = inline the WHOLE corpus in the system message. [PERSONA + corpus] is
#   then a byte-stable prefix, so nearly the entire prompt is a cache HIT every
#   turn (50x cheaper input) and the embed + Supabase legs leave the voice
#   critical path. Costs: more tokens on turn 1, and the model must find the
#   right row itself instead of being handed 8 focused chunks.
# Measure with `npm run eval` both ways before committing.
RETRIEVAL_MODE=hybrid
# Refuse to inline a corpus above this; falls back to retrieval automatically.
CORPUS_MAX_TOKENS=60000
